---
import Layout from "../components/Layout"; // Componente Layout
import Router from "../components/Router.jsx"; // Componente Router de React
import "bootstrap/dist/css/bootstrap.min.css";
import "../styles/global.css";
---

<head>
  <meta
    name="viewport"
    content="width=device-width, initial-scale=1, user-scalable=yes"
  />
  <title>Aljawas</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&display=swap"
  />
</head>

<!-- Aplicamos client:only a Layout y Router como componente de cliente -->
<Router client:only="react" />
